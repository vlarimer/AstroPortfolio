---

const { project, title, caption, type } = Astro.props;
---
<style>

    .blog-right-container {
        border-width: 1px;
        border-color: #94918f;
    }

    .portfolio-card-info {
        background-color:#e9e6e4;
        height: 100%;
    }


    .portfolio-card-title {
        font-size: 1.6em;
        font-weight: 300;
        padding-bottom: 1vh;
    }
    .portfolio-card-caption {
        font-size: .8em;
        font-weight: 900;
        padding-bottom: 2vh;
        font-style: italic;
    }

    img {
        height: 25vh;
        width: 100%;
        object-fit: cover;
    }

</style>


<div class="blog-right-container">
<div class="portfolio-card">

    
    <a href=`/${type}/${project}` style="text-decoration:none;">
    <div class="portfolio-card-info">

    <div class="portfolio-card-title">{title}</div>
    <div class="portfolio-card-caption">{caption}</div>
    </div>
    </a>

    <div class="portfolio-card-image">
    <img src=`src/assets/${project}/portfolio-card.png` alt={caption}>
    </div>

</div>
</div>